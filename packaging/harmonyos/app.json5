// Configuracion global del proyecto HAP de Tlaxtrelom (modelo Stage, API 12).
// Lo que consume DevEco Studio; `cargo xtask package --platform harmonyos`
// copia este arbol en dist/ junto a la biblioteca nativa ya compilada.
{
  "app": {
    "bundleName": "com.tlaxtrelom.engine",
    "vendor": "angiraulene1-create",
    "versionCode": 5,
    "versionName": "0.4.0-alpha.1",
    "icon": "$media:app_icon",
    "label": "$string:app_name",
    "minAPIVersion": 12,
    "targetAPIVersion": 12,
    "apiReleaseType": "Release"
  },
  "modules": [
    {
      "name": "entry",
      "type": "entry",
      "srcPath": "./entry",
      "srcEntry": "./ets/entryability/EntryAbility.ets"
    }
  ]
}
